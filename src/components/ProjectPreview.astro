---
import { type CollectionEntry } from 'astro:content';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, categories, award, techStack, githubUrl, demoUrl } = project.data;
const TitleTag = headingLevel;
---

<div
    class:list={[
        'reveal rounded-2xl border border-border bg-surface p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-accent/40',
        className
    ]}
>
    {(categories.length > 0 || award) && (
        <div class="mb-2 flex flex-wrap gap-1.5">
            {award && (
                <span class="inline-block rounded bg-amber-100 px-2 py-0.5 text-[10px] font-bold tracking-wider text-amber-800 uppercase dark:bg-amber-900/40 dark:text-amber-300">
                    {award}
                </span>
            )}
            {categories.map((cat) => (
                <span class="inline-block rounded bg-pink-50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-pink-600 uppercase dark:bg-pink-900/30 dark:text-pink-300">
                    {cat}
                </span>
            ))}
        </div>
    )}
    <TitleTag class="mb-1.5 font-bold text-lg leading-tight tracking-tight text-strong sm:text-xl">
        {title}
    </TitleTag>
    {description && <p class="mb-2 text-[14px] leading-relaxed text-muted">{description}</p>}
    {techStack.length > 0 && (
        <div class="mb-2 flex flex-wrap gap-2">
            {techStack.map((tech) => (
                <span class="inline-block rounded-full border border-border px-3 py-1 text-[13px] text-main">
                    {tech}
                </span>
            ))}
        </div>
    )}
    <div class="flex gap-4">
        {githubUrl && (
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-strong hover:decoration-accent"
            >
                GitHub ↗
            </a>
        )}
        {demoUrl && (
            <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-strong hover:decoration-accent"
            >
                Demo ↗
            </a>
        )}
    </div>
</div>
