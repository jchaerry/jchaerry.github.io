---
import { type CollectionEntry } from 'astro:content';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, categories, award, techStack, githubUrl, demoUrl } = project.data;
const TitleTag = headingLevel;
---

<div
    class:list={[
        'border-l-2 border-gray-200 dark:border-gray-800 pl-5 transition-colors hover:border-gray-400 dark:hover:border-gray-500',
        className
    ]}
>
    {(categories.length > 0 || award) && (
        <div class="mb-2 flex flex-wrap gap-1.5">
            {award && (
                <span class="inline-block rounded bg-amber-100 px-2 py-0.5 text-[10px] font-bold tracking-wider text-amber-800 uppercase dark:bg-amber-900/40 dark:text-amber-300">
                    {award}
                </span>
            )}
            {categories.map((cat) => (
                <span class="inline-block rounded bg-pink-50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-pink-600 uppercase dark:bg-pink-900/30 dark:text-pink-300">
                    {cat}
                </span>
            ))}
        </div>
    )}
    <TitleTag class="mb-1.5 font-serif text-lg leading-tight font-bold text-gray-900 dark:text-gray-100 sm:text-xl">
        {title}
    </TitleTag>
    {description && <p class="mb-2 text-[14px] leading-relaxed text-gray-600 dark:text-gray-400">{description}</p>}
    {techStack.length > 0 && (
        <div class="mb-2 flex flex-wrap gap-2">
            {techStack.map((tech) => (
                <span class="inline-block rounded-full border border-gray-300 px-3 py-1 text-[13px] text-gray-700 dark:border-gray-700 dark:text-gray-300">
                    {tech}
                </span>
            ))}
        </div>
    )}
    <div class="flex gap-4">
        {githubUrl && (
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-gray-400 underline decoration-gray-200 underline-offset-4 transition-colors hover:text-black dark:decoration-gray-800 dark:hover:text-white"
            >
                GitHub ↗
            </a>
        )}
        {demoUrl && (
            <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-gray-400 underline decoration-gray-200 underline-offset-4 transition-colors hover:text-black dark:decoration-gray-800 dark:hover:text-white"
            >
                Demo ↗
            </a>
        )}
    </div>
</div>
