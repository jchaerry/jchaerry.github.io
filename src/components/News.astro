---
// src/components/News.astro
import newsList from '../data/news.json';
import Button from './Button.astro';

const latestNews = newsList.slice(0, 5);
---

<div class="mb-10 sm:mb-12">
    <h2 class="mb-8 font-bold text-xl tracking-tight sm:mb-12 sm:text-2xl">News</h2>
    
    <ul class="flex max-h-[420px] flex-col gap-6 overflow-y-auto pr-2 sm:gap-8">
        {latestNews.map((news) => (
            <li class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="text-lg text-muted min-w-[140px] shrink-0">
                    {news.date}
                </span>
                <p
                class="text-xl text-main leading-relaxed [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-border [&_a]:transition-colors [&_a:hover]:text-accent [&_a:hover]:decoration-accent"
                set:html={news.title}
                />
            </li>
        ))}
    </ul>

    <div class="mt-12 sm:mt-16">
        <Button href="/news">View All News</Button>
    </div>
</div>