---
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import HomeHero from '../components/HomeHero.astro';
import PostPreview from '../components/PostPreview.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';
import News from '../components/News.astro';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const featuredPosts = posts.filter(({ data }) => data.isFeatured);

const allPapers = await getCollection('papers');
const selectedPapers = allPapers
    .filter((paper) => paper.data.selected === true)
    .sort(sortItemsByDateDesc);
---

<BaseLayout description={siteConfig.description} showHeader={false}>
    <HomeHero />
    <Hero text={siteConfig.hero?.text} image={siteConfig.hero?.image} />

    <div class="mb-16 sm:mb-24">
        <News />
    </div>
    
    {
        selectedPapers?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-12 font-bold text-xl tracking-tight sm:mb-16 sm:text-2xl">Selected Papers</h2>
                
                <div class="flex flex-col gap-10 sm:gap-12">
                    {selectedPapers.map((paper) => (
                        <div class="reveal flex flex-col relative rounded-2xl border border-border bg-surface p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-accent/40">
                            
                            {/* 특이사항 뱃지 */}
                            {paper.data.note && (
                                <div class="mb-2">
                                    <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 dark:text-blue-300 dark:bg-blue-900/30 rounded">
                                        {paper.data.note}
                                    </span>
                                </div>
                            )}

                            {/* 논문 제목 */}
                            <h3 class="font-bold text-lg text-strong mb-1.5 leading-tight tracking-tight">
                                {paper.data.title}
                            </h3>

                            {/* 저자 */}
                            <p class="text-[14px] text-muted mb-1 leading-relaxed" set:html={paper.data.authors} />

                            {/* 출판처 */}
                            {paper.data.venue && (
                                <p class="text-[13px] not-italic font-mono text-muted mb-3">
                                    {paper.data.venue}
                                </p>
                            )}

                            {/* DOI 링크 */}
                            {paper.data.paperUrl && (
                                <div class="mt-1">
                                    <a
                                        href={paper.data.paperUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-xs font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-strong hover:decoration-accent"
                                    >
                                        DOI ↗
                                    </a>
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                <div class="mt-12 sm:mt-16">
                    <Button href="/publications/papers">View All Papers</Button>
                </div>
            </div>
        )
    }
    {
        featuredPosts?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-12 font-bold text-xl tracking-tight sm:mb-16 sm:text-2xl">Writing</h2>
                {featuredPosts.slice(0, 5).map((post) => (
                    <PostPreview post={post} class="mb-10 sm:mb-12" headingLevel="h3" />
                ))}
                <div class="mt-12 sm:mt-16">
                    <Button href="/blog">View All Posts</Button>
                </div>
            </div>
        )
    }
</BaseLayout>