---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

const papers = (await getCollection('papers')).sort(sortItemsByDateDesc);
---

<BaseLayout title="Papers" showHeader={false}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-12 font-bold text-3xl tracking-tight text-strong border-b pb-4 border-border">
      Papers
    </h1>

    {papers.length > 0 ? (
      <div class="flex flex-col gap-10">
        {papers.map((paper) => (
          <div class="reveal flex flex-col relative rounded-2xl border border-border bg-surface p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-accent/40">
            
            {/* 특이사항 뱃지 */}
            {paper.data.note && (
              <div class="mb-2">
                <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 dark:text-blue-300 dark:bg-blue-900/30 rounded">
                  {paper.data.note}
                </span>
              </div>
            )}

            {/* 제목 */}
            <h2 class="font-bold text-lg text-strong mb-1.5 leading-tight tracking-tight">
              {paper.data.title}
            </h2>
            
            {/* 저자명 */}
            <p class="text-[14px] text-muted mb-1 leading-relaxed" set:html={paper.data.authors} />
            
            {/* 출판처 */}
            {paper.data.venue && (
              <p class="text-[13px] not-italic font-mono text-muted mb-3">
                {paper.data.venue}
              </p>
            )}
            
            {/* 하이퍼링크 */}
            {paper.data.paperUrl && (
              <div class="mt-1">
                <a 
                  href={paper.data.paperUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-xs font-semibold text-accent hover:text-accent-strong transition-colors underline underline-offset-4 decoration-accent/40 hover:decoration-accent"
                >
                  DOI ↗
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-muted italic">No papers published yet.</p>
    )}
  </div>
</BaseLayout>