---
import newsList from '../data/news.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const allNews = newsList;
---

<BaseLayout title="News" showHeader={false}>
    <div class="mx-auto max-w-3xl px-4 py-10">
        <h1 class="mb-12 font-bold text-3xl tracking-tight text-strong border-b pb-4 border-border">
            News
        </h1>

        <ul class="flex flex-col gap-6 sm:gap-8">
            {allNews.map((news) => (
                <li class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
                    <span class="text-lg text-muted min-w-[140px] shrink-0">
                        {news.date}
                    </span>
                    <p
                    class="text-xl text-main leading-relaxed [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-border [&_a]:transition-colors [&_a:hover]:text-accent [&_a:hover]:decoration-accent"
                    set:html={news.title}
                    />
                </li>
            ))}
        </ul>
    </div>
</BaseLayout>
